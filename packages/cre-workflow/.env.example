# CRE Workflow Environment Variables

# Deployer private key (funded with ETH on target chain)
# Used by CRE CLI for simulate --broadcast
CRE_ETH_PRIVATE_KEY=0x...

# RPC URLs
BASE_SEPOLIA_RPC_URL=https://base-sepolia.gateway.tenderly.co/YOUR_TENDERLY_TOKEN
ARBITRUM_SEPOLIA_RPC_URL=https://arbitrum-sepolia.gateway.tenderly.co/YOUR_TENDERLY_TOKEN
BASE_MAINNET_RPC_URL=https://mainnet.base.org
ARBITRUM_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc

# Optional: Monitoring API key
MONITORING_API_KEY=your-api-key-here
