# Root .env.example -- reference for all packages
#
# You do NOT need a root .env file. Each package has its own:
#   packages/foundry/.env          -- contract deployment, testing, verification
#   packages/nextjs/.env.local     -- frontend (Alchemy, WalletConnect)
#   packages/cre-workflow/.env     -- CRE workflow (private key, monitoring)
#
# Quick setup:
#   cp packages/foundry/.env.example packages/foundry/.env
#   cp packages/nextjs/.env.example packages/nextjs/.env.local
#   cp packages/cre-workflow/.env.example packages/cre-workflow/.env
#
# See README.md > Environment Setup for details.

# ─── packages/foundry/.env ────────────────────────────────────────────
# ALCHEMY_API_KEY=your-key          # RPC endpoints
# ETHERSCAN_API_KEY=your-key        # Contract verification
# RPC_BASE=https://...              # Fork tests against Base mainnet (default provided)
# LOCALHOST_KEYSTORE_ACCOUNT=scaffold-eth-default

# ─── packages/nextjs/.env.local ──────────────────────────────────────
# NEXT_PUBLIC_ALCHEMY_API_KEY=      # Frontend RPC (fallback in scaffold.config.ts)
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=  # WalletConnect (fallback in scaffold.config.ts)

# ─── packages/cre-workflow/.env ──────────────────────────────────────
# CRE_ETH_PRIVATE_KEY=0x...        # Funded testnet key for simulate --broadcast
# MONITORING_API_KEY=               # Optional monitoring endpoint key

# ─── packages/monitor (uses root .env or inline) ─────────────────────
# Uncomment and fill these if you want to run the monitor data pipeline.
# Get a free Alchemy key at https://dashboard.alchemy.com
# RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_AVALANCHE=https://avax-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_BNB=https://bnb-mainnet.g.alchemy.com/v2/YOUR_KEY
# MERKL_API_KEY=                    # Optional, 10 req/s without key
# LIFI_API_KEY=                     # Optional, works without key
